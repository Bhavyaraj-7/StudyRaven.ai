# StudyRaven environment variables.
# Copy to .env.local for local development and set the same names in
# Vercel → Project → Settings → Environment Variables.
# Never commit real values. .env.local is git-ignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# e.g. https://www.studyravenai.com (used in emails and OAuth redirects)
NEXT_PUBLIC_APP_URL=

# --- AI (all model calls go through OpenRouter) ---
OPENROUTER_API_KEY=
# Optional overrides. Defaults are in lib/ai/models.ts.
AI_PRIMARY_MODEL=
AI_FALLBACK_MODEL=

# --- Mesh API ---
# Reserved for Mesh. No code uses it yet; ask before wiring it in.
MESH_API_KEY=

# --- Web search (college guide) ---
TAVILY_API_KEY=

# --- Email ---
RESEND_API_KEY=
# e.g. StudyRaven <no-reply@studyravenai.com>, once the domain is verified in Resend
RESEND_FROM_EMAIL=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Google (Gmail/Classroom beta) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
